generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  FOOD_PROVIDER
  NGO
  DISTRIBUTOR
  ADMIN
}

enum AccountStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

enum VerificationStatus {
  VERIFIED
  PENDING
  REJECTED
}

enum AvailabilityStatus {
  AVAILABLE
  BUSY
  INACTIVE
  OFFLINE
}

enum DonationStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
  REQUESTED
  MATCHED
  ASSIGNED
  PICKUP_IN_PROGRESS
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  COMPLETED
  EXPIRED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  FULFILLED
}

enum DeliveryStatus {
  ASSIGNED
  PICKUP_IN_PROGRESS
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  COMPLETED
  CANCELLED
  DISPUTED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  URGENT
  ACTION_REQUIRED
}

enum WasteReason {
  EXPIRED_BEFORE_PICKUP
  SPOILED_IN_STORAGE
  DAMAGED_IN_TRANSIT
  CONTAMINATED
  REJECTED_AT_PICKUP
  REJECTED_AT_DELIVERY
  QUANTITY_MISMATCH_DISCARD
  COLD_CHAIN_FAILURE
  OTHER
}

enum DisposalMethod {
  COMPOSTING
  ANIMAL_FEED
  BIO_ENERGY_ANAEROBIC
  COMMERCIAL_INCINERATION
  LANDFILL_DISPOSAL
  NOT_SPECIFIED
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String
  phone         String?
  passwordHash  String
  role          UserRole
  accountStatus AccountStatus  @default(ACTIVE)
  avatarUrl     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  foodProvider  FoodProvider?
  ngo           Ngo?
  distributor   Distributor?
  notifications Notification[]
  auditLogs     AuditLog[]
  wasteRecords  WasteRecord[]

  @@index([email])
  @@index([role])
}

model FoodProvider {
  id                 String             @id @default(uuid())
  userId             String             @unique
  organizationName   String
  organizationType   String
  address            String
  city               String
  latitude           Float
  longitude          Float
  verificationStatus VerificationStatus @default(VERIFIED)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  donations          FoodDonation[]

  @@index([city])
  @@index([verificationStatus])
}

model Ngo {
  id                 String             @id @default(uuid())
  userId             String             @unique
  organizationName   String
  address            String
  city               String
  latitude           Float
  longitude          Float
  foodCapacity       Float
  availabilityStatus AvailabilityStatus @default(AVAILABLE)
  verificationStatus VerificationStatus @default(VERIFIED)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  requests           DonationRequest[]
  matches            Match[]
  deliveries         Delivery[]
  feedbacks          Feedback[]

  @@index([city])
  @@index([availabilityStatus])
  @@index([verificationStatus])
}

model Distributor {
  id                 String             @id @default(uuid())
  userId             String             @unique
  vehicleType        String
  availabilityStatus AvailabilityStatus @default(AVAILABLE)
  reliabilityScore   Float              @default(5.0)
  totalDeliveries    Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries         Delivery[]
  locationUpdates    LocationUpdate[]
  feedbacks          Feedback[]

  @@index([availabilityStatus])
}

model FoodDonation {
  id                  String            @id @default(uuid())
  humanReadableId     String            @unique
  providerId          String
  foodName            String
  foodCategory        String
  quantity            Float
  unit                String
  preparationTime     DateTime
  expiryTime          DateTime
  dietaryFlags        String?
  storageRequirements String?
  notes               String?
  imageUrl            String?
  status              DonationStatus    @default(SUBMITTED)
  rejectionReason     String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  provider            FoodProvider      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  requests            DonationRequest[]
  matches             Match[]
  delivery            Delivery?
  traceabilityLogs    TraceabilityLog[]
  wasteRecords        WasteRecord[]

  @@index([providerId])
  @@index([status])
  @@index([foodCategory])
  @@index([expiryTime])
}

model DonationRequest {
  id                String        @id @default(uuid())
  donationId        String
  ngoId             String
  requestedQuantity Float
  requestReason     String?
  status            RequestStatus @default(PENDING)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  donation          FoodDonation  @relation(fields: [donationId], references: [id], onDelete: Cascade)
  ngo               Ngo           @relation(fields: [ngoId], references: [id], onDelete: Cascade)

  @@index([donationId])
  @@index([ngoId])
  @@index([status])
}

model Match {
  id                   String       @id @default(uuid())
  donationId           String
  ngoId                String
  matchScore           Float
  distanceKm           Float
  capacityMatchScore   Float
  urgencyScore         Float
  availabilityScore    Float
  status               String       @default("SUGGESTED")
  calculationRationale String
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  donation             FoodDonation @relation(fields: [donationId], references: [id], onDelete: Cascade)
  ngo                  Ngo          @relation(fields: [ngoId], references: [id], onDelete: Cascade)

  @@index([donationId])
  @@index([ngoId])
  @@index([matchScore])
}

model Delivery {
  id                   String                @id @default(uuid())
  donationId           String                @unique
  distributorId        String
  ngoId                String
  providerId           String
  status               DeliveryStatus        @default(ASSIGNED)
  pickupEta            DateTime?
  deliveryEta          DateTime?
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  donation             FoodDonation          @relation(fields: [donationId], references: [id], onDelete: Cascade)
  distributor          Distributor           @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  ngo                  Ngo                   @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  pickupVerification   PickupVerification?
  deliveryVerification DeliveryVerification?
  locationUpdates      LocationUpdate[]
  feedback             Feedback?
  wasteRecords         WasteRecord[]

  @@index([distributorId])
  @@index([ngoId])
  @@index([providerId])
  @@index([status])
}

model LocationUpdate {
  id            String      @id @default(uuid())
  deliveryId    String
  distributorId String
  latitude      Float
  longitude     Float
  heading       Float?
  speed         Float?
  accuracy      Float?
  timestamp     DateTime    @default(now())
  createdAt     DateTime    @default(now())

  delivery      Delivery    @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  distributor   Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)

  @@index([deliveryId])
  @@index([distributorId])
  @@index([timestamp])
}

model PickupVerification {
  id               String   @id @default(uuid())
  deliveryId       String   @unique
  verifiedByUserId String
  verificationCode String
  packageCondition String   @default("GOOD")
  temperatureCheck String?
  photoUrl         String?
  notes            String?
  verifiedAt       DateTime @default(now())

  delivery         Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
}

model DeliveryVerification {
  id                String   @id @default(uuid())
  deliveryId        String   @unique
  confirmedByUserId String
  receivedQuantity  Float
  conditionStatus   String   @default("EXCELLENT")
  status            String   @default("CONFIRMED")
  disputeReason     String?
  notes             String?
  confirmedAt       DateTime @default(now())

  delivery          Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
}

model Feedback {
  id                 String      @id @default(uuid())
  deliveryId         String      @unique
  ngoId              String
  distributorId      String
  rating             Int
  punctualityRating  Int?
  foodQualityRating  Int?
  handlingRating     Int?
  comment            String?
  createdAt          DateTime    @default(now())

  delivery           Delivery    @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  ngo                Ngo         @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  distributor        Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)

  @@index([ngoId])
  @@index([distributorId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(INFO)
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  actorRole String
  action    String
  entity    String
  entityId  String
  ipAddress String?
  userAgent String?
  metadata  String?
  timestamp DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([entity])
  @@index([entityId])
  @@index([timestamp])
}

model TraceabilityLog {
  id          String       @id @default(uuid())
  donationId  String
  stage       String
  actor       String
  actorRole   String
  action      String
  description String
  location    String?
  metadata    String?
  timestamp   DateTime     @default(now())

  donation    FoodDonation @relation(fields: [donationId], references: [id], onDelete: Cascade)

  @@index([donationId])
  @@index([stage])
  @@index([timestamp])
}

model WasteRecord {
  id               String         @id @default(uuid())
  humanReadableId  String         @unique
  donationId       String?
  deliveryId       String?
  recordedByUserId String
  recordedRole     UserRole
  foodName         String
  foodCategory     String
  quantityWasted   Float
  unit             String         @default("KG")
  reason           WasteReason
  disposalMethod   DisposalMethod @default(NOT_SPECIFIED)
  stage            String
  notes            String?
  photoUrl         String?
  recordedAt       DateTime       @default(now())
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  donation         FoodDonation?  @relation(fields: [donationId], references: [id], onDelete: SetNull)
  delivery         Delivery?      @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  recordedBy       User           @relation(fields: [recordedByUserId], references: [id], onDelete: Cascade)

  @@index([reason])
  @@index([disposalMethod])
  @@index([recordedAt])
  @@index([stage])
  @@index([donationId])
  @@index([deliveryId])
}